# Project Titan - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys
# IMPORTANT: Never commit .env to git - it's in .gitignore

# Anthropic API (for Claude LLM)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_key_here

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
EVIDENCE_DB_PATH=./data/evidence.db

# Research Settings
MAX_SEARCHES_PER_COMPANY=5
RESEARCH_DEPTH=deep

# LLM Mode: standard (open-source only) | power (Anthropic for POWER_MODE_TASKS)
LLM_MODE=standard
LOCAL_LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_THINK=False

# Power mode only (needs: uv sync --extra power)
ANTHROPIC_MODEL=claude-sonnet-5-5
POWER_MODE_TASKS=text2sql,confidence_scoring,contradiction_detection,synthesis,claim_support

# Search: searxng (open source; start with: uv run python infra/searxng.py); opt-in paid: brave, brave_context
SEARCH_PROVIDERS=searxng
SEARXNG_URL=http://127.0.0.1:8080
# Get from: https://brave.com/search/api/ (only needed if SEARCH_PROVIDERS includes brave)
BRAVE_API_KEY=
SEARCH_TIMEOUT=20

# Your email or website. Sent in the User-Agent so site owners can reach you (required by Wikimedia).
TITAN_CONTACT=

# Langfuse tracing (optional). Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
# Traces include prompts and scraped page text. Obvious API keys are masked before sending.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
