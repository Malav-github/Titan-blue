     "tags": ["us-gaap:Revenues", "us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax", "us-gaap:SalesRevenueNet", "ifrs-full:Revenue"]},
    {"id": "other_income", "statement": "income", "kind": "money", "label": "Other income",
     "labels": ["other income", "other operating income"],
     "tags": ["ifrs-full:OtherIncome"]},
    {"id": "total_income", "statement": "income", "kind": "money", "label": "Total income",
     "labels": ["total income"], "tags": []},
    {"id": "cost_of_revenue", "statement": "income", "kind": "money", "label": "Cost of revenue",
     "labels": ["cost of revenue", "cost of revenues", "cost of sales", "cost of goods sold", "costs of sales and services", "cost of services"],
     "tags": ["us-gaap:CostOfRevenue", "us-gaap:CostOfGoodsAndServicesSold", "ifrs-full:CostOfSales"]},
    {"id": "gross_profit", "statement": "income", "kind": "money", "label": "Gross profit",
     "labels": ["gross profit", "gross margin"], "tags": ["us-gaap:GrossProfit", "ifrs-full:GrossProfit"]},
    {"id": "total_expenses", "statement": "income", "kind": "money", "label": "Total expenses",
     "labels": ["total expenses", "total costs and expenses", "costs and expenses", "total operating expenses", "expenses"],
     "tags": ["us-gaap:CostsAndExpenses", "us-gaap:OperatingExpenses"]},
    {"id": "finance_costs", "statement": "income", "kind": "money", "label": "Finance costs",
     "labels": ["finance costs", "finance cost", "interest expense", "interest expense, net", "finance charges"],
     "tags": ["us-gaap:InterestExpense", "us-gaap:InterestExpenseNonoperating", "ifrs-full:FinanceCosts"]},
    {"id": "depreciation_amortization", "statement": "income", "kind": "money", "label": "Depreciation and amortisation",
