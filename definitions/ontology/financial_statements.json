     "tags": ["us-gaap:NetIncomeLossAttributableToNoncontrollingInterest", "ifrs-full:ProfitLossAttributableToNoncontrollingInterests"]},
    {"id": "other_comprehensive_income", "statement": "income", "kind": "money", "label": "Other comprehensive income",
     "labels": ["other comprehensive income", "total other comprehensive income", "other comprehensive income (loss)", "other comprehensive income/(loss)", "other comprehensive income, net of tax"],
     "tags": ["us-gaap:OtherComprehensiveIncomeLossNetOfTax", "ifrs-full:OtherComprehensiveIncome"]},
    {"id": "total_comprehensive_income", "statement": "income", "kind": "money", "label": "Total comprehensive income",
     "labels": ["total comprehensive income", "total comprehensive income for the period", "total comprehensive income for the year", "comprehensive income"],
     "tags": ["us-gaap:ComprehensiveIncomeNetOfTaxIncludingPortionAttributableToNoncontrollingInterest", "ifrs-full:ComprehensiveIncome"]},
    {"id": "eps_basic", "statement": "income", "kind": "per_share", "label": "Basic earnings per share",
     "labels": ["basic", "basic earnings per share", "basic eps", "basic (in rs.)", "basic (₹)", "earnings per share - basic", "basic earnings per share (in rs.)"],
     "tags": ["us-gaap:EarningsPerShareBasic", "ifrs-full:BasicEarningsLossPerShare"]},
    {"id": "eps_diluted", "statement": "income", "kind": "per_share", "label": "Diluted earnings per share",
     "labels": ["diluted", "diluted earnings per share", "diluted eps", "diluted (in rs.)", "diluted (₹)", "earnings per share - diluted"],
     "tags": ["us-gaap:EarningsPerShareDiluted", "ifrs-full:DilutedEarningsLossPerShare"]},

    {"id": "cash", "statement": "balance", "kind": "money", "label": "Cash and cash equivalents",
     "labels": ["cash and cash equivalents", "cash and equivalents", "cash & cash equivalents"],
     "tags": ["us-gaap:CashAndCashEquivalentsAtCarryingValue", "ifrs-full:CashAndCashEquivalents"]},
    {"id": "receivables", "statement": "balance", "kind": "money", "label": "Trade receivables",
     "labels": ["accounts receivable, net", "trade receivables", "trade and other receivables", "trade and other receivables - net", "accounts receivable", "receivables"],
     "tags": ["us-gaap:AccountsReceivableNetCurrent", "ifrs-full:TradeAndOtherCurrentReceivables"]},
    {"id": "inventories", "statement": "balance", "kind": "money", "label": "Inventories",
     "labels": ["inventories", "inventory", "inventories, net"], "tags": ["us-gaap:InventoryNet", "ifrs-full:Inventories"]},
    {"id": "total_current_assets", "statement": "balance", "kind": "money", "label": "Total current assets",
     "labels": ["total current assets"], "tags": ["us-gaap:AssetsCurrent", "ifrs-full:CurrentAssets"]},
    {"id": "ppe", "statement": "balance", "kind": "money", "label": "Property, plant and equipment",
     "labels": ["property, plant and equipment", "property, plant and equipment - net", "property, plant and equipment, net", "property and equipment, net"],
     "tags": ["us-gaap:PropertyPlantAndEquipmentNet", "ifrs-full:PropertyPlantAndEquipment"]},
    {"id": "goodwill", "statement": "balance", "kind": "money", "label": "Goodwill",
     "labels": ["goodwill"], "tags": ["us-gaap:Goodwill", "ifrs-full:Goodwill"]},
    {"id": "total_noncurrent_assets", "statement": "balance", "kind": "money", "label": "Total non-current assets",
     "labels": ["total non-current assets", "total noncurrent assets"], "tags": ["us-gaap:AssetsNoncurrent", "ifrs-full:NoncurrentAssets"]},
    {"id": "total_assets", "statement": "balance", "kind": "money", "label": "Total assets",
     "labels": ["total assets"], "tags": ["us-gaap:Assets", "ifrs-full:Assets"]},
    {"id": "total_current_liabilities", "statement": "balance", "kind": "money", "label": "Total current liabilities",
     "labels": ["total current liabilities"], "tags": ["us-gaap:LiabilitiesCurrent", "ifrs-full:CurrentLiabilities"]},
    {"id": "total_noncurrent_liabilities", "statement": "balance", "kind": "money", "label": "Total non-current liabilities",
     "labels": ["total non-current liabilities", "total noncurrent liabilities"], "tags": ["us-gaap:LiabilitiesNoncurrent", "ifrs-full:NoncurrentLiabilities"]},
    {"id": "total_liabilities", "statement": "balance", "kind": "money", "label": "Total liabilities",
     "labels": ["total liabilities"], "tags": ["us-gaap:Liabilities", "ifrs-full:Liabilities"]},
    {"id": "temporary_equity", "statement": "balance", "kind": "money", "label": "Redeemable non-controlling interests (between liabilities and equity)",
     "labels": ["redeemable noncontrolling interests", "redeemable non-controlling interests", "temporary equity"],
     "tags": ["us-gaap:RedeemableNoncontrollingInterestEquityCarryingAmount", "us-gaap:TemporaryEquityCarryingAmountAttributableToParent", "us-gaap:TemporaryEquityCarryingAmountIncludingPortionAttributableToNoncontrollingInterests"]},
    {"id": "share_capital", "statement": "balance", "kind": "money", "label": "Share capital",
     "labels": ["share capital", "equity share capital", "capital stock", "common stock", "paid-up equity share capital"],
     "tags": ["us-gaap:CommonStockValue", "ifrs-full:IssuedCapital"]},
    {"id": "retained_earnings", "statement": "balance", "kind": "money", "label": "Retained earnings",
     "labels": ["retained earnings", "retained income", "retained earnings (deficit)"],
     "tags": ["us-gaap:RetainedEarningsAccumulatedDeficit", "ifrs-full:RetainedEarnings"]},
    {"id": "equity_parent", "statement": "balance", "kind": "money", "label": "Equity attributable to the parent",
     "labels": ["total equity attributable to shareholders of the parent company", "equity attributable to owners of the parent", "total equity attributable to equity holders of the parent", "total s&p global inc. equity", "total stockholders' equity", "total shareholders' equity"],
     "tags": ["us-gaap:StockholdersEquity", "ifrs-full:EquityAttributableToOwnersOfParent"]},
    {"id": "equity_nci", "statement": "balance", "kind": "money", "label": "Non-controlling interests",
     "labels": ["non-controlling interests", "noncontrolling interests", "non-controlling interest", "noncontrolling interest"],
     "tags": ["us-gaap:MinorityInterest", "ifrs-full:NoncontrollingInterests"]},
    {"id": "total_equity", "statement": "balance", "kind": "money", "label": "Total equity",
     "labels": ["total equity"], "tags": ["us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest", "ifrs-full:Equity"]},
    {"id": "total_liabilities_and_equity", "statement": "balance", "kind": "money", "label": "Total liabilities and equity",
     "labels": ["total liabilities and equity", "total equity and liabilities", "total liabilities and stockholders' equity", "total liabilities and shareholders' equity", "total liabilities and equity (deficit)"],
     "tags": ["us-gaap:LiabilitiesAndStockholdersEquity", "ifrs-full:EquityAndLiabilities"]},

    {"id": "cfo", "statement": "cash_flow", "kind": "money", "label": "Cash from operating activities",
     "labels": ["cash provided by operating activities", "net cash provided by operating activities", "net cash from operating activities", "net cash generated from operating activities", "net cash flow from operating activities", "net cash provided by (used in) operating activities", "net cash generated from/(used in) operating activities", "net cash from (used in) operating activities"],
     "tags": ["us-gaap:NetCashProvidedByUsedInOperatingActivities", "ifrs-full:CashFlowsFromUsedInOperatingActivities"]},
    {"id": "cfi", "statement": "cash_flow", "kind": "money", "label": "Cash from investing activities",
     "labels": ["cash used for investing activities", "net cash used in investing activities", "net cash from investing activities", "net cash used in investing activities", "net cash flow used in investing activities", "net cash provided by (used in) investing activities", "net cash (used in)/generated from investing activities", "cash provided by (used for) investing activities", "net cash from (used in) investing activities"],
     "tags": ["us-gaap:NetCashProvidedByUsedInInvestingActivities", "ifrs-full:CashFlowsFromUsedInInvestingActivities"]},
    {"id": "cff", "statement": "cash_flow", "kind": "money", "label": "Cash from financing activities",
     "labels": ["cash used for financing activities", "net cash used in financing activities", "net cash from financing activities", "net cash flow used in financing activities", "net cash provided by (used in) financing activities", "net cash (used in)/generated from financing activities", "cash provided by (used for) financing activities", "net cash from (used in) financing activities"],
     "tags": ["us-gaap:NetCashProvidedByUsedInFinancingActivities", "ifrs-full:CashFlowsFromUsedInFinancingActivities"]},
    {"id": "fx_effect_cash", "statement": "cash_flow", "kind": "money", "label": "Effect of exchange rates on cash",
     "labels": ["effect of exchange rate changes on cash", "effect of exchange rate changes on cash and cash equivalents", "effect of exchange rate changes on cash, cash equivalents and restricted cash", "effect of foreign exchange rate changes on cash and cash equivalents", "effect of exchange rate changes on cash and cash equivalents held in foreign currencies"],
     "tags": ["us-gaap:EffectOfExchangeRateOnCashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents", "us-gaap:EffectOfExchangeRateOnCashAndCashEquivalents", "ifrs-full:EffectOfExchangeRateChangesOnCashAndCashEquivalents"]},
    {"id": "net_change_cash", "statement": "cash_flow", "kind": "money", "label": "Net change in cash",
     "labels": ["net change in cash, cash equivalents, and restricted cash", "net change in cash, cash equivalents and restricted cash", "net increase (decrease) in cash and cash equivalents", "net increase/(decrease) in cash and cash equivalents", "net decrease in cash and cash equivalents", "net increase in cash and cash equivalents", "net change in cash and cash equivalents", "net (decrease) increase in cash and cash equivalents"],
     "tags": ["us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalentsPeriodIncreaseDecreaseIncludingExchangeRateEffect", "us-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease", "ifrs-full:IncreaseDecreaseInCashAndCashEquivalents"]},
    {"id": "cash_beginning", "statement": "cash_flow", "kind": "money", "label": "Cash at the beginning of the period",
     "labels": ["cash, cash equivalents, and restricted cash at beginning of period", "cash, cash equivalents and restricted cash at beginning of period", "cash and cash equivalents at beginning of period", "cash and cash equivalents at the beginning of the period", "cash and cash equivalents at beginning of year", "cash and cash equivalents at the beginning of the year", "cash and cash equivalents, beginning", "cash and cash equivalents at january 1"],
     "tags": []},
    {"id": "cash_end", "statement": "cash_flow", "kind": "money", "label": "Cash at the end of the period",
     "labels": ["cash, cash equivalents, and restricted cash at end of period", "cash, cash equivalents and restricted cash at end of period", "cash and cash equivalents at end of period", "cash and cash equivalents at the end of the period", "cash and cash equivalents at end of year", "cash and cash equivalents at the end of the year", "cash and cash equivalents, end", "cash and cash equivalents at end of the period"],
     "tags": []}
  ],

  "patterns": {
    "note": "Wordings too varied to list: a regular expression over the label key, used only when no listed label matches, and like a label it names no row when two rows match it.",
    "cfo": "^net cash (?:flows? )?(?:provided by|from|generated (?:from|by)|used in|\\(used in\\)|\\(used in\\)/generated from|generated from/\\(used in\\)|provided by \\(used in\\)|from \\(used in\\))\\s*operating activities$",
    "cfi": "^net cash (?:flows? )?(?:provided by|from|generated (?:from|by)|used in|\\(used in\\)|\\(used in\\)/generated from|generated from/\\(used in\\)|provided by \\(used in\\)|from \\(used in\\))\\s*investing activities$",
    "cff": "^net cash (?:flows? )?(?:provided by|from|generated (?:from|by)|used in|\\(used in\\)|\\(used in\\)/generated from|generated from/\\(used in\\)|provided by \\(used in\\)|from \\(used in\\))\\s*financing activities$",
    "fx_effect_cash": "^(?:net )?effects? of (?:changes in )?(?:foreign )?(?:currency )?exchange rates? (?:changes |differences |fluctuations )?on cash",
    "net_change_cash": "^net (?:\\(?(?:increase|decrease)\\)?\\s*/?\\s*)+(?:in|of) cash(?: and cash equivalents)?$|^net change in cash",
    "cash_beginning": "^cash and cash equivalents,? (?:at )?(?:the )?(?:beginning|start|opening)",
    "cash_end": "^cash and cash equivalents,? (?:at )?(?:the )?(?:end|closing)"
  },

  "rules": [
    {"id": "assets_split", "statement": "balance", "total": "total_assets", "parts": ["total_current_assets", "total_noncurrent_assets"]},
    {"id": "liabilities_split", "statement": "balance", "total": "total_liabilities", "parts": ["total_current_liabilities", "total_noncurrent_liabilities"]},
    {"id": "equity_split", "statement": "balance", "total": "total_equity", "parts": ["equity_parent", "equity_nci"]},
    {"id": "liabilities_and_equity", "statement": "balance", "total": "total_liabilities_and_equity", "parts": ["total_liabilities", "?temporary_equity", "total_equity"]},
    {"id": "balance_sheet_balances", "statement": "balance", "total": "total_assets", "parts": ["total_liabilities_and_equity"]},
    {"id": "balance_sheet_balances_without_total_row", "statement": "balance", "total": "total_assets", "parts": ["total_liabilities", "?temporary_equity", "total_equity"], "unless": ["total_liabilities_and_equity"]},
    {"id": "total_income", "statement": "income", "total": "total_income", "parts": ["revenue", "other_income"]},
    {"id": "gross_profit", "statement": "income", "total": "gross_profit", "parts": ["revenue", "-cost_of_revenue"]},
    {"id": "profit_before_exceptional", "statement": "income", "total": "profit_before_exceptional", "parts": ["total_income", "-total_expenses"]},
    {"id": "profit_after_tax", "statement": "income", "total": "net_income", "parts": ["profit_before_tax", "-income_tax"], "unless": ["income_continuing", "income_discontinued"]},
    {"id": "continuing_after_tax", "statement": "income", "total": "income_continuing", "parts": ["profit_before_tax", "-income_tax"]},
    {"id": "continuing_and_discontinued", "statement": "income", "total": "net_income", "parts": ["income_continuing", "income_discontinued"]},
    {"id": "net_income_split", "statement": "income", "total": "net_income", "parts": ["net_income_parent", "net_income_nci"]},
    {"id": "comprehensive_income", "statement": "income", "total": "total_comprehensive_income", "parts": ["net_income", "other_comprehensive_income"]},
    {"id": "cash_flow_sum", "statement": "cash_flow", "total": "net_change_cash", "parts": ["cfo", "cfi", "cff"],
     "or": [["cfo", "cfi", "cff", "fx_effect_cash"]]},
    {"id": "cash_roll_forward", "statement": "cash_flow", "total": "cash_end", "parts": ["cash_beginning", "net_change_cash"],
     "or": [["cash_beginning", "net_change_cash", "fx_effect_cash"]]}
  ],
  "rule_notes": "'or' lists other ways a company may present the same total (the exchange-rate effect inside the net change, as US filers print it, or after it, as many IFRS filers do); the rule passes when one of them adds up, and the check records which. A part written '-x' is subtracted; companies print an expense either as a positive number to subtract or already in brackets, so both readings are tried and the one used is recorded. A part written '?x' is included when the table has it. 'unless' skips the rule when the table has those concepts. A rule runs only when the table has every required concept for the same column; otherwise it is not checked, never passed."
}
