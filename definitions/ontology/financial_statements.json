{
  "version": 1,
  "summary": "What a financial statement is, for code that reads tables: the statements, the standard line items (concepts) with their XBRL tags and the labels companies print for them, the words that state a table's scale and currency, the words that name a reporting period, and the arithmetic a statement must satisfy. Built for any market: US GAAP and IFRS tags, labels as Indian and Philippine companies print them, lakh and crore. Add a market by adding its labels, scale words and tags here, not by changing code.",

  "statements": [
    {"id": "income", "label": "Income statement", "period": "duration",
     "title": "statements? of (?:consolidated |condensed |standalone |separate )*(?:income|operations|earnings|profit (?:or|and) loss)|income statements?|profit (?:and|&) loss|p&l|statement of comprehensive income|financial results\\b"},
    {"id": "comprehensive_income", "label": "Statement of comprehensive income", "period": "duration",
     "title": "statements? of (?:consolidated |condensed )*comprehensive (?:income|loss)"},
    {"id": "balance", "label": "Balance sheet", "period": "instant",
     "title": "balance sheets?|statements? of (?:consolidated |condensed |standalone |separate )*financial (?:position|condition)|statement of assets and liabilities"},
    {"id": "cash_flow", "label": "Cash flow statement", "period": "duration",
     "title": "statements? of (?:consolidated |condensed |standalone |separate )*cash flows?|cash flow statements?|(?:^|\\d\\.\\s*)cash flows?\\b(?!\\s+(?:from|used|provided|generated))"},
    {"id": "equity", "label": "Statement of changes in equity", "period": "duration",
     "title": "statements? of (?:consolidated |condensed )*(?:changes in )?(?:stockholders'?|shareholders'?|owners'?)?\\s*equity|changes in equity",
     "rows": "^balances?,? (?:as of|at|as at)\\b"}
  ],

  "bases": [
    {"id": "consolidated", "cues": "\\bconsolidated\\b|\\band subsidiaries\\b"},
    {"id": "standalone", "cues": "\\bstand-?alone\\b|\\bseparate (?:financial )?statements?\\b|\\bparent company(?: only)?\\b"}
  ],

  "standards": [
    {"id": "us_gaap", "cues": "\\bU\\.?S\\.? GAAP\\b|\\bus-gaap:"},
    {"id": "ifrs", "cues": "\\bIFRS\\b|\\bifrs-full:"},
    {"id": "ind_as", "cues": "\\bInd ?AS\\b|Indian Accounting Standards"},
    {"id": "pfrs", "cues": "\\bPFRS\\b|Philippine Financial Reporting Standards"}
  ],

  "scales": {
    "words": {
      "in billions": "1000000000", "billions": "1000000000", "in millions": "1000000", "millions": "1000000", "in million": "1000000",
      "mn": "1000000", "in thousands": "1000", "thousands": "1000", "in thousand": "1000",
      "in crores": "10000000", "in crore": "10000000", "crores": "10000000", "crore": "10000000", "cr.": "10000000",
      "in lakhs": "100000", "in lakh": "100000", "lakhs": "100000", "lakh": "100000", "lacs": "100000"
    },
    "currencies": {
      "INR": ["₹", "rs.", "rs", "inr", "rupees", "indian rupees"],
      "PHP": ["₱", "php", "philippine peso", "philippine pesos", "pesos", "peso"],
      "USD": ["us$", "usd", "u.s. dollars", "us dollars", "dollars", "$"]
    },
    "whole_units": "\\b(?:all )?amounts? (?:are )?(?:expressed |presented )?in (?:philippine |indian |u\\.?s\\.? )?(?:pesos?|rupees|dollars)\\b"
  },

  "periods": {
    "duration_words": {
      "three months ended": 3, "3 months ended": 3, "quarter ended": 3, "quarter ending": 3, "three months ending": 3,
      "six months ended": 6, "6 months ended": 6, "half year ended": 6, "half-year ended": 6, "half yearly ended": 6,
      "nine months ended": 9, "9 months ended": 9,
      "three-month period ended": 3, "three-month periods ended": 3, "six-month period ended": 6, "six-month periods ended": 6,
      "nine-month period ended": 9, "nine-month periods ended": 9, "twelve-month period ended": 12,
      "twelve months ended": 12, "12 months ended": 12, "year ended": 12, "years ended": 12, "fiscal year ended": 12, "financial year ended": 12
    },
    "bare_duration_words": {"three months": 3, "six months": 6, "nine months": 9, "twelve months": 12, "three-month": 3, "six-month": 6, "nine-month": 9, "twelve-month": 12, "quarter": 3, "half year": 6, "full year": 12},
    "bare_note": "used only when the table's caption states the day the periods end ('Three and nine months ended September 30, 2026 and 2025')",
    "instant_words": ["as at", "as of", "as on", "at"],
    "not_periods": "\\b(?:yoy|y-o-y|qoq|q-o-q|change|growth|variance|%\\s*change|increase\\s*/\\s*\\(?decrease\\)?|inc\\s*/\\s*\\(?dec\\)?)\\b",
    "numeric_dates": "day_first_with_dots"
  },

  "kinds": ["money", "per_share", "shares", "ratio"],

  "concepts": [
