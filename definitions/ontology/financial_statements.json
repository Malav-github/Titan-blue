    {"id": "operating_income", "statement": "income", "kind": "money", "label": "Operating income",
     "labels": ["operating income", "operating profit", "income from operations", "operating profit (loss)", "operating income (loss)"],
     "tags": ["us-gaap:OperatingIncomeLoss", "ifrs-full:ProfitLossFromOperatingActivities"]},
    {"id": "profit_before_exceptional", "statement": "income", "kind": "money", "label": "Profit before exceptional items and tax",
     "labels": ["profit before exceptional items and tax", "profit/(loss) before exceptional items and tax", "profit before exceptional items and tax expense"],
     "tags": []},
    {"id": "exceptional_items", "statement": "income", "kind": "money", "label": "Exceptional items",
     "labels": ["exceptional items", "exceptional items (net)"], "tags": []},
    {"id": "profit_before_tax", "statement": "income", "kind": "money", "label": "Profit before tax",
     "labels": ["profit before tax", "profit/(loss) before tax", "income before taxes on income", "income from continuing operations before taxes on income", "income from continuing operations before income taxes", "income before income taxes", "income before taxes", "earnings before income taxes", "profit before income tax", "income (loss) before income taxes", "pre-tax profit"],
     "tags": ["us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest", "us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesMinorityInterestAndIncomeLossFromEquityMethodInvestments", "ifrs-full:ProfitLossBeforeTax"]},
    {"id": "income_tax", "statement": "income", "kind": "money", "label": "Income tax",
     "labels": ["tax expense", "total tax expense", "provision for taxes on income", "provision for income taxes", "income tax expense", "income taxes", "income tax", "tax expense (net)", "provision for income tax"],
     "tags": ["us-gaap:IncomeTaxExpenseBenefit", "ifrs-full:IncomeTaxExpenseContinuingOperations"]},
    {"id": "income_continuing", "statement": "income", "kind": "money", "label": "Income from continuing operations",
     "labels": ["income from continuing operations", "profit from continuing operations", "net income from continuing operations", "profit for the period from continuing operations", "net profit from continuing operations"],
     "tags": ["us-gaap:IncomeLossFromContinuingOperationsIncludingPortionAttributableToNoncontrollingInterest", "ifrs-full:ProfitLossFromContinuingOperations"],
     "tag_note": "us-gaap:IncomeLossFromContinuingOperations is the parent's share only, so it is not this concept"},
    {"id": "income_discontinued", "statement": "income", "kind": "money", "label": "Income from discontinued operations",
     "labels": ["income from discontinued operations, net of taxes", "(loss) income from discontinued operations, net of taxes", "income (loss) from discontinued operations, net of tax", "profit from discontinued operations", "profit/(loss) from discontinued operations", "net profit from discontinued operations"],
     "tags": ["us-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax", "ifrs-full:ProfitLossFromDiscontinuedOperations"]},
    {"id": "net_income", "statement": "income", "kind": "money", "label": "Net income",
