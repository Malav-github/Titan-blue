{
  "id": "company_events",
  "version": "1.0",
  "about": "The kinds of company event Titan records, each with the parts that make it complete, the date that matters, the words that point to it, one worked example and the rules code checks. Read by code: the full file validates claims and finds conflicts; a model is only ever shown the few predicates that fit the question (a definition and the example each), as a fixed list it must choose from. 'other.fact' catches a true claim that fits nothing, so nothing verifiable is lost. Field values in an example appear word for word in its quote. Examples use made-up companies (Northwind, Contoso, Litware, Tailspin, Acme, Fabrikam, Woodgrove) so they can never be mistaken for evidence about a real one.",
  "field_types": {
    "org": "an organisation's name as written",
    "person": "a person's name as written",
    "money": "an amount with its currency ('$2.1 billion')",
    "number": "a count or figure",
    "percent": "a percentage",
    "date": "a date as written ('October 27, 2026')",
    "period": "a reporting period as written ('fiscal 2026 fourth quarter')",
    "role": "a job title ('chief executive officer')",
    "text": "a short phrase from the quote"
  },
  "rule_kinds": {
    "order": "this event's date is not before the date of `after` for the same event (matched on `key`)",
    "one_holder": "at any date, one value of `field` per `key` (one CEO per company)",
    "needs_period": "a figure is meaningless without the period it covers",
    "needs_field": "the claim must give `field`"
  },
  "groups": [
    {
      "id": "transactions",
      "label": "Acquisitions, mergers, divestitures and investments"
    },
    {
      "id": "strategy",
      "label": "Strategic reviews, restructuring, partnerships and products"
    },
    {
      "id": "leadership",
      "label": "Leadership and board"
    },
    {
      "id": "financial",
      "label": "Results, guidance and capital returns"
    },
    {
      "id": "legal",
      "label": "Legal and regulatory"
    },
    {
      "id": "fallback",
      "label": "Anything else"
    }
  ],
  "predicates": [
    {
      "id": "acquisition.announced",
      "group": "transactions",
      "label": "Acquisition announced",
      "event_kind": "announced",
      "definition": "A company agreed or announced that it will acquire another company, business or asset.",
      "fields": [
        {
          "name": "acquirer",
          "type": "org",
          "required": true
        },
        {
          "name": "target",
          "type": "org",
          "required": true
        },
        {
          "name": "price",
          "type": "money",
          "required": false
        },
        {
          "name": "consideration",
          "type": "text",
          "required": false
        },
        {
          "name": "expected_close",
          "type": "text",
          "required": false
        }
      ],
      "key": [
        "acquirer",
        "target"
      ],
      "cues": "\\b(?:to acquire|agreed to (?:buy|acquire|purchase)|definitive agreement|will acquire|acquisition of|to buy|takeover bid|tender offer)\\b",
      "example": {
        "quote": "Northwind Data announced it has entered into a definitive agreement to acquire Fabrikam Analytics for $1.2 billion in cash.",
        "fields": {
          "acquirer": "Northwind Data",
          "target": "Fabrikam Analytics",
          "price": "$1.2 billion",
          "consideration": "in cash"
        }
      },
      "rules": []
    },
    {
      "id": "acquisition.completed",
      "group": "transactions",
      "label": "Acquisition completed",
      "event_kind": "completed",
      "definition": "An announced acquisition closed: the buyer now owns the target.",
      "fields": [
        {
          "name": "acquirer",
          "type": "org",
          "required": true
        },
        {
          "name": "target",
          "type": "org",
          "required": true
        },
        {
          "name": "price",
          "type": "money",
          "required": false
        }
      ],
      "key": [
        "acquirer",
        "target"
      ],
      "cues": "\\b(?:completed (?:the|its) acquisition|completes acquisition|closed (?:the|its) acquisition|completion of (?:the|its) acquisition|has acquired)\\b",
      "example": {
        "quote": "Northwind Data today announced that it has completed its acquisition of Fabrikam Analytics.",
        "fields": {
          "acquirer": "Northwind Data",
          "target": "Fabrikam Analytics"
        }
      },
      "rules": [
        {
          "kind": "order",
          "after": "acquisition.announced",
          "key": [
            "acquirer",
            "target"
          ]
        }
      ]
    },
    {
      "id": "acquisition.terminated",
      "group": "transactions",
      "label": "Acquisition terminated",
      "event_kind": "effective",
      "definition": "An announced acquisition was called off, blocked or abandoned.",
      "fields": [
        {
          "name": "acquirer",
          "type": "org",
          "required": true
        },
        {
          "name": "target",
          "type": "org",
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "required": false
        }
      ],
      "key": [
        "acquirer",
        "target"
      ],
      "cues": "\\b(?:terminat(?:ed|es|ion of) (?:the|its) (?:merger|acquisition|agreement)|abandon(?:ed|s) (?:the|its) (?:deal|bid)|walk(?:ed)? away from)\\b",
      "example": {
        "quote": "Contoso and Litware announced that they have mutually agreed to terminate their merger agreement.",
        "fields": {
          "acquirer": "Contoso",
          "target": "Litware"
        }
      },
      "rules": [
        {
          "kind": "order",
          "after": "acquisition.announced",
          "key": [
            "acquirer",
            "target"
          ]
        }
      ]
    },
